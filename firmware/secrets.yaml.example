# Copy to firmware/secrets.yaml and fill in. The real secrets.yaml is .gitignored.
# ESPHome reads these with the !secret tag in esp32_ld2450_*.yaml.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Hostname of the Pi 4B running Mosquitto. .local works if mDNS is up.
mqtt_broker: "gemmahome.local"
mqtt_username: ""        # leave blank during bring-up (allow_anonymous)
mqtt_password: ""

# OTA password for re-flashing over wifi after first USB flash
ota_password: "change-me-after-bringup"

# ESPHome API key (32-byte base64 string) — generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "REPLACE_ME_32_BYTE_BASE64"
